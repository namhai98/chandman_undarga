# Local development only. On Netlify these are set in the site's
# environment variables instead (DATABASE_URL comes from the Neon integration).

# ── Server / API ──────────────────────────────────────────
# Postgres connection string. Local example:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chandman_undarga
# Neon / managed example (TLS auto-enabled):
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
PORT=3001
# Comma-separated origins allowed to call the API. Leave unset on Netlify
# (site and function share a domain); set it when the API is cross-origin.
CORS_ORIGIN=http://localhost:5173
# Shared secret for the read-only GET /api/gift-orders listing.
ADMIN_KEY=change-me

# ── Client ────────────────────────────────────────────────
# Base URL for API calls. Empty = same origin (Vite proxy in dev,
# Netlify redirect in prod). Only set this if the API lives elsewhere.
VITE_API_URL=
