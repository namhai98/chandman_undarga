# ── Server ────────────────────────────────────────────────
# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chandman_undarga
PORT=3001
# Comma-separated origins allowed to call the API (dev Vite server by default)
CORS_ORIGIN=http://localhost:5173
# Simple shared secret for the read-only admin listing endpoint
ADMIN_KEY=change-me

# ── Client ────────────────────────────────────────────────
# Base URL for API calls. Leave empty in dev to use the Vite proxy.
VITE_API_URL=
